# Copy to .env and fill in. Never commit the real file.

# --- Discord ---
DISCORD_TOKEN=

# --- Postgres (compose derives DATABASE_URL from these) ---
# Keep the password URL-safe: letters, digits, and - _ only.
POSTGRES_USER=juliabot
POSTGRES_PASSWORD=
POSTGRES_DB=juliabot

# --- Bot behavior ---
PREFIX=!
TZ=America/Sao_Paulo
ANIME_SCRAP_TIME=3600
BOT_JIKAN_RATE_LIMIT=50
SCRAP_JIKAN_RATE_LIMIT=10
TEST_MODE=false

# --- Optional ---
# Required for the changelog cog: without it the bot shells out to git, which
# the image does not contain.
GITHUB_REPOSITORY=mdabessa/JuliaBot
DEEPSEEK_API_KEY=
